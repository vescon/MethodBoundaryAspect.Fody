<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <!-- Fody only loads (and FodyPackaging only packs) the netstandard2.0 weaver, so tests use exactly that binary -->
    <TargetFramework>netstandard2.0</TargetFramework>
  </PropertyGroup>
      
  <ItemGroup>
    <!-- the configuration schema, FodyPackaging packs it from the output folder of the weaver -->
    <None Include="MethodBoundaryAspect.Fody.xcf" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="FodyHelpers" Version="6.7.0" developmentDependency="true" />
  </ItemGroup>
</Project>