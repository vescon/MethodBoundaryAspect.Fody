<?xml version="1.0" encoding="utf-8"?>
<!-- Coverage of the weaver only. Without the filter the test assemblies are instrumented too: the weaver then reads
     aspects with changed IL, and the tests of the instance reuse and of the usage analysis fail. -->
<RunSettings>
  <DataCollectionRunSettings>
    <DataCollectors>
      <DataCollector friendlyName="XPlat Code Coverage">
        <Configuration>
          <Format>cobertura</Format>
          <Include>[MethodBoundaryAspect.Fody]*</Include>
        </Configuration>
      </DataCollector>
    </DataCollectors>
  </DataCollectionRunSettings>
</RunSettings>
